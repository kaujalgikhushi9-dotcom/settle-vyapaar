# Copy this file to .env and fill it in. NEVER commit .env.
# On Vercel, add the same names in Project Settings > Environment Variables.

# PayPal SANDBOX app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# LLM for the pricing assistant. FREE option: Groq (console.groq.com, no credit card).
# If no key is set, the app falls back to a clearly labeled template mode.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional paid alternative:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Used only if the live rate API is unreachable. Put a recent USD->INR mid-market rate here.
# It is shown to the user as a "snapshot", never as live.
FALLBACK_USD_INR=88.2

# Only needed if the frontend is hosted on a different origin than this API.
# Same-origin deployments (Vercel, the Express preview) need nothing here.
ALLOWED_ORIGIN=

# Leave empty for the same-origin API. Only set this if the React app is served
# from a different domain than the Express server.
VITE_API_BASE_URL=

PORT=3000
